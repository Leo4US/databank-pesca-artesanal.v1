    <!-- TELA 5: GALERIA DE VISUALIZAÇÕES (SEÇÃO 23 DA ESPECIFICAÇÃO) -->
    <section id="tab-visualizacoes" class="tab-content">
      <div style="margin-bottom: 2rem;">
        <span class="badge badge-demo" style="margin-bottom: 0.5rem;">Visualização como produção</span>
        <h2 style="font-size: 1.8rem; font-weight: 700;">Galeria de visualizações publicadas</h2>
        <p style="font-size: 0.875rem; color: var(--text-muted);">Cada visualização possui título, proveniência, página própria e citação direta.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 2rem;">
        <div style="background-color: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: 10px; padding: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span class="badge badge-validated">VIS-DEMO-0042</span>
            <span style="font-size: 0.75rem; color: var(--text-light);">Publicado em 2026</span>
          </div>
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem;">Teia de exposição e agravos ocupacionais (SST)</h3>
          <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1rem;">Mapeamento percentual da exposição contínua na Pesca Artesanal.</p>
          <div style="height: 280px; position: relative;">
            <canvas id="chartVis1"></canvas>
          </div>
          <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center;">
