  <div class="mosaic-strip">
    <div class="m-block" style="background-color: var(--color-accent);"></div>
    <div class="m-block" style="background-color: var(--color-secondary);"></div>
    <div class="m-block" style="background-color: var(--color-success);"></div>
    <div class="m-block" style="background-color: var(--color-primary);"></div>
    <div class="m-block" style="background-color: var(--color-danger);"></div>
  </div>

  <!-- CHART.JS BIBLIOTECA -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- LÓGICA FRONT-END E NAVEGAÇÃO LOCAL -->
  <script>
    // DICIONÁRIO DE INTERNACIONALIZAÇÃO (PT | EN)
    const i18n = {
      PT: {
        subbrand: "Banco de Dados e Produções Científicas",
        btnAnalys: "Analisar Dados",
        badgeHero: "Publicação Científica Interativa",
        heroTitle: "Trabalho, saúde e territórios da pesca artesanal no Brasil",
        heroSubtitle: "Conheça a pesquisa do Programa Trabalho Saudável e Seguro na Pesca Artesanal (PTSSPA), seu instrumento e os caminhos de exploração científica dos dados.",
        btnHero1: "Explorar Resultados",
        btnHero2: "Analisar Dados",
        btnHero3: "Conhecer a Pesquisa",
        seqTitle: "Sequência Empírica do Instrumento (Q01 a Q36)",
        seqSub: "A ordem empírica original do questionário é preservada sem reorganização artificial.",
        lblM1: "Questões do Instrumento",
        lblM2: "Atributos / Alternativas",
        lblM3: "Campos Cadastrais",
        lblM4: "Aplicações Validadas",
        discTitle: "O que você quer descobrir?"
      },
      EN: {
        subbrand: "Database e Scientific Publications",
        btnAnalys: "Analyze Data",
        badgeHero: "Interactive Scientific Publication",
        heroTitle: "Work, health and territories of artisanal fishing in Brazil",
        heroSubtitle: "Discover the research, its questionnaire and the scientific data exploration tools developed within the PTSSPA programme.",
        btnHero1: "Explore Results",
        btnHero2: "Analyze Data",
        btnHero3: "Learn About Research",
        seqTitle: "Empirical Instrument Sequence (Q01 to Q36)",
        seqSub: "The original empirical order of the questionnaire is preserved without artificial reorganization.",
        lblM1: "Instrument Questions",
        lblM2: "Attributes / Alternatives",
        lblM3: "Cadastral Fields",
        lblM4: "Validated Applications",
        discTitle: "What do you want to discover?"
      }
    };

    function setLanguage(lang) {
      document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');

      const data = i18n[lang];
      if (!data) return;

      document.getElementById('txt-subbrand').innerText = data.subbrand;
      document.getElementById('btn-top-analys').innerText = data.btnAnalys;
      document.getElementById('badge-hero').innerText = data.badgeHero;
      document.getElementById('hero-title').innerText = data.heroTitle;
      document.getElementById('hero-subtitle').innerText = data.heroSubtitle;
      document.getElementById('btn-hero-1').innerText = data.btnHero1;
      document.getElementById('btn-hero-2').innerText = data.btnHero2;
      document.getElementById('btn-hero-3').innerText = data.btnHero3;
      document.getElementById('txt-seq-title').innerText = data.seqTitle;
      document.getElementById('txt-seq-sub').innerText = data.seqSub;
      document.getElementById('lbl-m1').innerText = data.lblM1;
      document.getElementById('lbl-m2').innerText = data.lblM2;
      document.getElementById('lbl-m3').innerText = data.lblM3;
      document.getElementById('lbl-m4').innerText = data.lblM4;
      document.getElementById('txt-disc-title').innerText = data.discTitle;
    }

    // NAVEGAÇÃO DE TABS
    function showTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
      document.querySelectorAll('nav a').forEach(link => link.classList.remove('active'));

      const targetTab = document.getElementById('tab-' + tabId);
      if (targetTab) targetTab.classList.add('active');

      const targetNav = document.getElementById('nav-' + tabId);
      if (targetNav) targetNav.classList.add('active');

      window.scrollTo({ top: 0, behavior: 'smooth' });

      if (tabId === 'explorar') renderChartExplorar();
      if (tabId === 'visualizacoes') renderChartVis();
    }

    function openQuestion(qCode) {
      showTab('explorar');
    }

    // LÓGICA DO CONSTRUTOR DE FRASES HUMANAS
    const bVar = document.getElementById('b-var');
    const bUniv = document.getElementById('b-univ');
    const bStrat = document.getElementById('b-strat');
    const humanPhrase = document.getElementById('human-phrase');

    function updateHumanPhrase() {
      if (!humanPhrase) return;
      const varText = bVar.options[bVar.selectedIndex].text;
      const univText = bUniv.options[bUniv.selectedIndex].text;
      const stratText = bStrat.options[bStrat.selectedIndex].text;
      humanPhrase.innerHTML = `"Você está perguntando como se distribui <strong>${varText}</strong> entre <strong>${univText}</strong>, estratificado por <strong>${stratText}</strong>."`;
    }

    if (bVar) {
      bVar.addEventListener('change', updateHumanPhrase);
      bUniv.addEventListener('change', updateHumanPhrase);
      bStrat.addEventListener('change', updateHumanPhrase);
    }

    function executeAnalysis() {
      document.getElementById('analysis-result-box').style.display = 'block';
      renderChartLabResult();
      window.scrollTo({ top: document.getElementById('analysis-result-box').offsetTop - 100, behavior: 'smooth' });
    }

    // DRAWERS e MODAIS
    function openDrawer(type) {
      const drawerTitle = document.getElementById('drawer-title');
      const drawerBody = document.getElementById('drawer-body');
      
      if (type === 'SOBRE') {
        drawerTitle.innerText = "Sobre Este Resultado e Proveniência";
        drawerBody.innerHTML = `
          <div class="meta-item"><label>Identificador da Análise</label><span>ANL-DEMO-000184</span></div>
          <div class="meta-item"><label>Unidade Analítica</label><span>Seleção de Alternativa (1)</span></div>
          <div class="meta-item"><label>Denominador Explícito</label><span>Total de Aplicações com Q23 respondida (N = 16.623)</span></div>
          <div class="meta-item"><label>Território Cadastral</label><span>Endereço Cadastral (End. UF)</span></div>
          <div class="meta-item"><label>Limitação Metodológica</label><span>O valor 0 representa alternativa não marcada e não implica resposta negativa formal.</span></div>
        `;
      } else if (type === 'CITAR') {
        drawerTitle.innerText = "Orientações de Citação Direta";
        drawerBody.innerHTML = `
          <div class="meta-item">
            <label>Padrão ABNT</label>
            <div style="font-family: var(--font-mono); font-size: 0.75rem; background: var(--bg-subtle); padding: 0.6rem; border-radius: 4px; word-break: break-all;">
              FUNDACENTRO. Análise Demonstrativa ANL-DEMO-000184: Q23 Acidentes. In: Fundacentro Research Studio: Pesca Artesanal. São Paulo: Fundacentro, 2026.
            </div>
          </div>
          <div class="meta-item">
            <label>DOI / Identificador</label>
            <span>DOI não informado / não atribuído</span>
          </div>
        `;
      }

      document.getElementById('drawer-backdrop').classList.add('active');
      document.getElementById('drawer-panel').classList.add('active');
    }

    function closeDrawer() {
      document.getElementById('drawer-backdrop').classList.remove('active');
      document.getElementById('drawer-panel').classList.remove('active');
    }

    function openModalDownload() {
      document.getElementById('modal-download').classList.add('active');
    }

    function closeModalDownload() {
      document.getElementById('modal-download').classList.remove('active');
    }

    function showConfirmationSimulated() {
      const email = document.getElementById('cad-email').value;
      document.getElementById('sim-email-display').innerText = email;
      showTab('confirmacao');
    }

    // CHART.JS RENDERERS
    let c1 = null, c2 = null, c3 = null;

    function renderChartExplorar() {
      if (c1) c1.destroy();
      const ctx = document.getElementById('chartExplorarGeral');
      if (!ctx) return;
      c1 = new Chart(ctx.getContext('2d'), {
        type: 'bar',
        data: {
          labels: ['Corte / Perfuração', 'Queda na Embarcação', 'Ferida por Animal', 'Queimadura Solar', 'Não Sofreu'],
          datasets: [{
            label: 'Prevalência Amostral (%)',
            data: [45.4, 29.6, 24.6, 14.6, 33.3],
            backgroundColor: '#1D4FB1',
            borderRadius: 4
          }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
      });
    }

    function renderChartLabResult() {
      if (c2) c2.destroy();
      const ctx = document.getElementById('chartLabResult');
      if (!ctx) return;
      c2 = new Chart(ctx.getContext('2d'), {
        type: 'bar',
        data: {
          labels: ['Corte / Perfuração', 'Queda', 'Animal Marinho', 'Queimadura Solar'],
          datasets: [
            { label: 'Feminino (%)', data: [38.2, 31.4, 21.0, 12.1], backgroundColor: '#C27329' },
            { label: 'Masculino (%)', data: [51.2, 28.1, 27.3, 16.8], backgroundColor: '#1D4FB1' }
          ]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    }

    function renderChartVis() {
      if (c3) c3.destroy();
      const ctx = document.getElementById('chartVis1');
      if (!ctx) return;
      c3 = new Chart(ctx.getContext('2d'), {
        type: 'radar',
        data: {
          labels: ['Exposição Solar', 'Carga/Peso', 'Movimento Repetitivo', 'Risco Queda', 'Ruído'],
          datasets: [{
            label: 'Prevalência (%)',
            data: [74.2, 91.3, 82.5, 68.4, 42.1],
            backgroundColor: 'rgba(29, 79, 177, 0.2)',
            borderColor: '#1D4FB1',
            pointBackgroundColor: '#C27329'
          }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
      });
    }

    window.addEventListener('DOMContentLoaded', () => {
      renderChartExplorar();
    });
  </script>
<script>
/* 26F.04: Consultas reais sob demanda ao CORE via API agregada Cloud Run. */
(() => {
  'use strict';
  const API_BASE = 'https://pesca-analytics-api-v1-311761842391.southamerica-east1.run.app';
  const CATALOG_URL = './data/questoes_alternativas.json';
  let catalog = null;
  const byId = id => document.getElementById(id);
  const qmap = () => new Map((catalog?.questoes || []).map(q => [q.codigo, q]));
  const countText = n => Number.isInteger(n) ? n.toLocaleString('pt-BR') : 'Suprimida (1 a 4)';
  function note(element, text) {
    element.hidden = false;
    element.replaceChildren();
    const p = document.createElement('p');
    p.className = 'funda-state';
    p.textContent = text;
    element.appendChild(p);
  }
  function setOptions(element, questions) {
    element.replaceChildren();
    for (const q of questions) {
      const option = document.createElement('option');
      option.value = q.codigo;
      option.textContent = q.codigo + ' · ' + q.texto;
      element.appendChild(option);
    }
  }
  function updateExplore() {
    const q = qmap().get(byId('exp-questao').value);
    if (!q) return;
    byId('exp-enunciado').textContent = q.codigo + ' · ' + q.texto;
    const target = byId('exp-alternativas');
    target.replaceChildren();
    for (const a of q.alternativas) {
      const div = document.createElement('div');
      div.className = 'funda-option';
      div.textContent = a.codigo + ' · ' + a.texto;
      target.appendChild(div);
    }
    byId('exp-status').textContent = `${q.alternativas.length} alternativas catalogadas · CORE`;
    byId('exp-resultado').hidden = true;
  }
  function updatePhrase() {
    const q1 = qmap().get(byId('lab-q1').value);
    const crossed = byId('lab-tipo').value === 'cruzamento';
    byId('lab-q2-wrap').hidden = !crossed;
    const q2 = qmap().get(byId('lab-q2').value);
    byId('lab-frase').textContent = crossed
      ? `Quero cruzar ${q1?.codigo}: ${q1?.texto} com ${q2?.codigo}: ${q2?.texto}.`
      : `Quero consultar a distribuição de ${q1?.codigo}: ${q1?.texto}.`;
    byId('lab-resultado').hidden = true;
  }
  async function apiRequest(path, body = null) {
    const settings = {method: body ? 'POST' : 'GET', cache: 'no-store', headers: {Accept:'application/json'}};
    if (body) {settings.headers['Content-Type'] = 'application/json';settings.body = JSON.stringify(body);}
    const response = await fetch(API_BASE + path, settings);
    if (!response.ok) {
      let detail = '';
      try {const data = await response.json();detail = data.detail || '';} catch (_) {}
      throw new Error(`HTTP ${response.status}${detail ? ' · ' + detail : ''}`);
    }
    return response.json();
  }
  function cell(tr, value, tag='td') {
    const el = document.createElement(tag);
    el.textContent = value;
    tr.appendChild(el);
  }
  function showTable(target, headingText, heads, rows, details) {
    target.hidden = false;
    target.replaceChildren();
    const heading = document.createElement('h3');
    heading.textContent = headingText;
    target.appendChild(heading);
    const table = document.createElement('table');
    table.className = 'funda-result-table';
    const thead = document.createElement('thead');
    const trh = document.createElement('tr');
    heads.forEach(h => cell(trh, h, 'th'));
    thead.appendChild(trh);
    table.appendChild(thead);
    const tbody = document.createElement('tbody');
    for (const row of rows) {
      const tr = document.createElement('tr');
      row.forEach(v => cell(tr,v));
      tbody.appendChild(tr);
    }
    table.appendChild(tbody);
    target.appendChild(table);
    const p = document.createElement('p');
    p.className = 'funda-note';
    p.textContent = details;
    target.appendChild(p);
  }
  async function runQuery(type, q1, q2, target, button) {
    if (!catalog) {note(target,'Catálogo ainda não disponível.');return;}
    const previous = button.textContent;
    button.disabled = true;
    button.textContent = 'Consultando o CORE...';
    note(target,'Consultando contagens reais no PostgreSQL. Aguarde...');
    try {
      if (type === 'frequencia') {
        const data = await apiRequest('/consultas/frequencia?questao=' + encodeURIComponent(q1));
        if (data.tipo !== 'frequencia' || data.questao !== q1 || !Array.isArray(data.resultados)) throw new Error('Resposta da API inválida');
        const item = qmap().get(q1);
        const counts = new Map(data.resultados.map(r => [r.alternativa, r]));
        const rows = item.alternativas.map(a => {
          const r = counts.get(a.codigo);
          return [a.codigo, a.texto, r ? countText(r.quantidade) : '0'];
        });
        showTable(target, `${q1} · Distribuição real por alternativa`, ['Código', 'Alternativa', 'Respondentes'], rows,
          'Fonte: PostgreSQL CORE via Cloud Run. Respondentes distintos por alternativa marcada. Múltiplas alternativas podem ser marcadas por pessoa. Valores de 1 a 4 suprimidos; percentuais não calculados.');
      } else {
        const data = await apiRequest('/consultas/cruzamento', {questao_1:q1,questao_2:q2});
        if (data.tipo !== 'cruzamento' || data.questao_1 !== q1 || data.questao_2 !== q2 || !Array.isArray(data.resultados)) throw new Error('Resposta da API inválida');
        const qs = qmap();
        const labels1 = new Map((qs.get(q1)?.alternativas||[]).map(a => [a.codigo,a.texto]));
        const labels2 = new Map((qs.get(q2)?.alternativas||[]).map(a => [a.codigo,a.texto]));
        const rows = data.resultados.map(r => [
          `${r.alternativa_1} · ${labels1.get(r.alternativa_1)||r.alternativa_1}`,
          `${r.alternativa_2} · ${labels2.get(r.alternativa_2)||r.alternativa_2}`,
          countText(r.quantidade)
        ]);
        showTable(target, `${q1} × ${q2} · Cruzamento real`, [`${q1} · alternativa`, `${q2} · alternativa`, 'Respondentes'], rows,
          'Fonte: PostgreSQL CORE via Cloud Run. Respondentes distintos com ambas as alternativas marcadas na mesma aplicação. Múltiplas escolhas podem produzir mais de uma combinação. Células de 1 a 4 suprimidas.');
      }
    } catch(e) {
      console.error('Falha na consulta da API:', e);
      note(target, `Não foi possível executar a consulta: ${e.message}. Se a API funciona isoladamente, conferir CORS e permissões de invocação do Cloud Run.`);
    } finally {
      button.disabled = false;
      button.textContent = previous;
    }
  }
  async function init() {
    try {
      const response = await fetch(CATALOG_URL,{cache:'no-store'});
      if (!response.ok) throw new Error('Catálogo HTTP '+response.status);
      catalog = await response.json();
      if (!Array.isArray(catalog.questoes) || catalog.questoes.length!==36 || catalog.questoes.reduce((n,q)=>n+(q.alternativas?.length||0),0)!==251) throw new Error('Catálogo divergente');
      for (const id of ['exp-questao','lab-q1','lab-q2']) setOptions(byId(id),catalog.questoes);
      byId('exp-questao').value = 'Q23';
      byId('lab-q1').value = 'Q05';
      byId('lab-q2').value = 'Q23';
      byId('exp-questao').addEventListener('change',updateExplore);
      for (const id of ['lab-tipo','lab-q1','lab-q2']) byId(id).addEventListener('change',updatePhrase);
      byId('exp-abrir').addEventListener('click',()=>runQuery('frequencia',byId('exp-questao').value,null,byId('exp-resultado'),byId('exp-abrir')));
      byId('lab-executar').addEventListener('click',()=>{
        const crossed=byId('lab-tipo').value==='cruzamento';
        runQuery(crossed?'cruzamento':'frequencia',byId('lab-q1').value,crossed?byId('lab-q2').value:null,byId('lab-resultado'),byId('lab-executar'));
      });
      updateExplore(); updatePhrase();
    } catch(e) {
      console.error('Falha no catálogo:',e);
      byId('exp-status').textContent = 'Catálogo indisponível: '+e.message;
      note(byId('lab-resultado'),'Falha ao carregar catálogo: '+e.message);
    }
  }
  window.renderChartExplorar = () => {};
  window.openQuestion = code => {showTab('explorar');if(catalog&&qmap().has(code)){byId('exp-questao').value=code;updateExplore();}};
  document.addEventListener('DOMContentLoaded',init);
})();
</script>
<script>
/* Tradução PT/EN exclusiva da Home, sem alterar o sistema de dados. */
(function(){
 const text={PT:{badge:'Estúdio de pesquisa · PTSSPA',title:'Trabalho, saúde e pesca artesanal no Brasil',subtitle:'Conheça a pesquisa vinculada ao Programa Trabalho Saudável e Seguro na Pesca Artesanal (PTSSPA), seu instrumento quantitativo, o percurso de organização dos dados e os cuidados necessários à interpretação dos resultados.',b1:'Explorar questões',b2:'Analisar dados',b3:'Conhecer a pesquisa ↓'},EN:{badge:'Research Studio · PTSSPA',title:'Work, health and artisanal fishing in Brazil',subtitle:'Explore the research linked to the Healthy and Safe Work in Artisanal Fishing Programme (PTSSPA), its quantitative questionnaire, the data preparation journey and the principles for interpreting results.',b1:'Explore questions',b2:'Analyze data',b3:'About the research ↓'}};
 function homeLanguage(lang){const d=text[lang]||text.PT;const ids={'badge-hero':d.badge,'hero-title':d.title,'hero-subtitle':d.subtitle,'btn-hero-1':d.b1,'btn-hero-2':d.b2,'btn-hero-3':d.b3};for(const [id,val] of Object.entries(ids)){const el=document.getElementById(id);if(el)el.textContent=val;}document.querySelectorAll('#tab-Início [data-pt][data-en]').forEach(el=>el.textContent=el.getAttribute('data-'+lang.toLowerCase()));}
 document.querySelectorAll('.lang-btn').forEach((btn,i)=>btn.addEventListener('click',()=>homeLanguage(i===0?'PT':'EN')));
 window.hsCopyCitation=function(title){const t='OLIVEIRA, L. A. B. '+title+'. 2026. Figura metodológica. Fundacentro. Referência provisória, a completar com URL e identificação da publicação.';if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(t).catch(()=>window.prompt('Copie a referência:',t));else window.prompt('Copie a referência:',t);};
 homeLanguage('PT');
})();
</script>
</body>
</html>
