<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Plataforma Fundacentro de Dados e Analytics — Pesca Artesanal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  
  <style>
    /* ==========================================================================
       1. SISTEMA VISUAL EDITORIAL E IDENTIDADE CORPORATIVA (ESPECIFICAÇÃO v0.2)
       ========================================================================== */
    :root {
      --bg-cream: #FBF9F0;
      --bg-card: #FFFFFF;
      --bg-subtle: #F3F1E5;
      --text-main: #0F172A;
      --text-muted: #475569;
      --text-light: #64748B;
      --border-subtle: #E2E0D2;
      --border-accent: #CBD5E1;
      
      /* Mosaico Geométrico Abstrato */
      --color-yellow: #E4C027;
      --color-ochre: #C27329;
      --color-green: #22C55E;
      --color-blue: #1D4FB1;
      --color-red: #E22927;
      
      --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-cream);
      color: var(--text-main);
      font-family: var(--font-sans);
      line-height: 1.5;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      background-image: radial-gradient(rgba(15, 23, 42, 0.04) 1px, transparent 0);
      background-size: 24px 24px;
    }

    a { color: inherit; text-decoration: none; }

    /* ==========================================================================
       2. CABEÇALHO GLOBAL E NAVEGAÇÃO BILÍNGUE
       ========================================================================== */
    header {
      background-color: rgba(251, 249, 240, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0.85rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .brand-title {
      font-weight: 800;
      font-size: 1.05rem;
      letter-spacing: -0.02em;
      color: var(--text-main);
    }

    .brand-subtitle {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-ochre);
      display: block;
    }

    nav ul {
      display: flex;
      list-style: none;
      gap: 0.35rem;
      align-items: center;
    }

    nav a {
      padding: 0.5rem 0.75rem;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-muted);
      border-radius: 6px;
      transition: all 0.2s ease;
    }

    nav a:hover, nav a.active {
      color: var(--text-main);
      background-color: var(--bg-subtle);
    }

    .btn-cadastro {
      background-color: var(--color-yellow) !important;
      color: var(--text-main) !important;
      font-weight: 700 !important;
      border-radius: 6px;
      padding: 0.5rem 0.9rem !important;
      border: 1px solid var(--border-subtle);
    }

    .btn-access {
      background-color: var(--text-main) !important;
      color: white !important;
      font-weight: 600;
      border-radius: 6px;
      padding: 0.5rem 0.95rem !important;
    }

    .lang-selector {
      display: flex;
      gap: 0.2rem;
      background-color: var(--bg-subtle);
      padding: 0.2rem;
      border-radius: 6px;
      border: 1px solid var(--border-subtle);
      font-size: 0.72rem;
      font-weight: 700;
    }

    .lang-btn {
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      cursor: pointer;
    }

    .lang-btn.active {
      background-color: var(--text-main);
      color: white;
    }

    /* ==========================================================================
       3. ESTRUTURA EDITORIAL E COMPONENTES
       ========================================================================== */
    main {
      flex: 1;
      max-width: 1400px;
      width: 100%;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 1.5rem;
      transition: border-color 0.2s ease;
    }

    .card:hover { border-color: var(--border-accent); }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.25rem 0.6rem;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-radius: 20px;
      width: fit-content;
    }

    .badge-demo { background-color: rgba(228, 192, 39, 0.18); color: #856404; }
    .badge-validated { background-color: rgba(34, 197, 94, 0.15); color: #15803D; }

    .badge::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: currentColor;
    }

    /* Hero Banner */
    .hero-banner {
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 3rem 2.5rem;
      margin-bottom: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
      position: relative;
      overflow: hidden;
    }

    .hero-banner::after {
      content: '';
      position: absolute;
      top: 0; right: 0; width: 6px; height: 100%;
      background: linear-gradient(180deg, var(--color-yellow), var(--color-ochre), var(--color-green), var(--color-blue), var(--color-red));
    }

    .hero-text h1 {
      font-size: 2.1rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.25;
      margin-top: 0.5rem;
      margin-bottom: 1rem;
    }

    .hero-text p {
      font-size: 1.02rem;
      color: var(--text-muted);
      max-width: 820px;
      margin-bottom: 1.8rem;
    }

    .btn-group { display: flex; gap: 0.8rem; flex-wrap: wrap; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1.4rem;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      border: 1px solid transparent;
    }

    .btn-primary { background-color: var(--color-blue); color: white; }
    .btn-primary:hover { background-color: #163F93; }
    .btn-secondary { background-color: var(--bg-subtle); color: var(--text-main); border-color: var(--border-subtle); }
    .btn-secondary:hover { background-color: #E6E3D3; }

    /* KPI Grid */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.2rem;
      margin-bottom: 2.5rem;
    }

    .kpi-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 1.5rem;
      position: relative;
    }

    .kpi-card .accent-line {
      position: absolute;
      top: 0; left: 1.5rem; right: 1.5rem;
      height: 3px;
      border-radius: 0 0 4px 4px;
    }

    .kpi-value {
      font-size: 2.2rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      font-family: var(--font-mono);
      margin-top: 0.5rem;
      margin-bottom: 0.25rem;
    }

    .kpi-label {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-light);
    }

    .kpi-sub { font-size: 0.78rem; color: var(--text-muted); margin-top: 0.5rem; }

    /* Seção de Navegação Empírica Q01 a Q36 */
    .empiric-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.6rem;
      margin-top: 1rem;
    }

    .q-item {
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 6px;
      padding: 0.65rem 0.85rem;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-main);
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .q-item:hover {
      border-color: var(--color-blue);
      background-color: var(--bg-subtle);
      transform: translateY(-1px);
    }

    .q-sub { font-size: 0.68rem; font-weight: 500; color: var(--text-light); }

    /* Layout de Exploração Avançada */
    .explorer-layout {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 1.5rem;
    }

    .filter-panel {
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 1.5rem;
      height: fit-content;
    }

    .panel-header {
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-light);
      margin-bottom: 1.2rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .filter-group { margin-bottom: 1.2rem; }

    .filter-group label {
      display: block;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
    }

    .filter-group select, .filter-group input, .filter-group textarea {
      width: 100%;
      padding: 0.6rem 0.8rem;
      border: 1px solid var(--border-subtle);
      border-radius: 6px;
      background-color: var(--bg-cream);
      font-family: var(--font-sans);
      font-size: 0.85rem;
      color: var(--text-main);
      outline: none;
    }

    .cross-builder {
      background-color: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 1rem;
      margin-bottom: 1.5rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      align-items: center;
    }

    .cross-builder-title {
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--text-main);
      width: 100%;
    }

    .chip-btn {
      padding: 0.4rem 0.85rem;
      font-size: 0.78rem;
      font-weight: 600;
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .chip-btn.active {
      background-color: var(--color-blue);
      color: white;
      border-color: var(--color-blue);
    }

    .data-table-container {
      overflow-x: auto;
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
      background-color: var(--bg-card);
    }

    .data-table th {
      background-color: var(--bg-subtle);
      padding: 0.8rem 1rem;
      font-weight: 700;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border-subtle);
      text-align: left;
    }

    .data-table td {
      padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .data-table tr:last-child td { border-bottom: none; }

    /* Módulo de Citação Direta e Proveniência */
    .citation-card {
      background-color: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 1.25rem;
      margin-top: 1.5rem;
    }

    .citation-card h4 {
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--text-main);
      margin-bottom: 0.6rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .citation-box {
      background-color: var(--bg-card);
      border: 1px solid var(--border-accent);
      border-radius: 6px;
      padding: 0.8rem;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--text-main);
      user-select: all;
      margin-bottom: 0.6rem;
      word-break: break-all;
    }

    .action-row {
      display: flex;
      gap: 0.8rem;
      margin-top: 1rem;
      flex-wrap: wrap;
    }

    /* Grid DataVis e Insights */
    .datavis-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }

    .chart-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 1.5rem;
    }

    .chart-container {
      position: relative;
      height: 320px;
      width: 100%;
    }

    .insights-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.2rem;
      margin-top: 1.5rem;
    }

    .insight-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 1.25rem;
      border-left: 4px solid var(--color-blue);
    }

    .insight-title {
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-main);
      margin-bottom: 0.4rem;
    }

    .insight-body { font-size: 0.875rem; color: var(--text-muted); }
    .insight-stat { font-family: var(--font-mono); font-weight: 700; color: var(--color-ochre); }

    /* Rodapé Institucional */
    footer {
      background-color: var(--bg-card);
      border-top: 1px solid var(--border-subtle);
      padding: 3rem 1.5rem 1.5rem;
      margin-top: 4rem;
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    .footer-container {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .footer-col h4 {
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-main);
      margin-bottom: 0.8rem;
    }

    .footer-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .footer-col a:hover {
      color: var(--color-blue);
      text-decoration: underline;
    }

    .mosaic-strip { height: 4px; width: 100%; display: flex; }
    .m-block { flex: 1; }

    @media (max-width: 900px) {
      .explorer-layout, .datavis-grid { grid-template-columns: 1fr; }
      .hero-banner { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>

  <!-- Mosaico Abstrato Superior -->
  <div class="mosaic-strip">
    <div class="m-block" style="background-color: var(--color-yellow);"></div>
    <div class="m-block" style="background-color: var(--color-ochre);"></div>
    <div class="m-block" style="background-color: var(--color-green);"></div>
    <div class="m-block" style="background-color: var(--color-blue);"></div>
    <div class="m-block" style="background-color: var(--color-red);"></div>
  </div>

  <!-- CABEÇALHO GLOBAL -->
  <header>
    <div class="nav-container">
      <div class="brand">
        <svg width="38" height="38" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M 10 35 L 35 10 L 60 35 L 35 60 Z" fill="#E4C027"/>
          <path d="M 60 10 L 85 10 L 85 35 L 60 35 Z" fill="#22C55E"/>
          <path d="M 35 35 L 85 35 L 85 85 L 35 85 Z" fill="#C27329"/>
          <path d="M 10 60 L 35 60 L 35 85 Z" fill="#1D4FB1"/>
          <path d="M 60 85 L 85 85 L 60 98 Z" fill="#E22927"/>
        </svg>
        <div>
          <span class="brand-title">Fundacentro Data & Analytics</span>
          <span class="brand-subtitle">Plataforma do Banco de Dados e Produções</span>
        </div>
      </div>

      <nav>
        <ul>
          <li><a href="#" onclick="showTab('home')" class="active" id="nav-home">Visão Geral</a></li>
          <li><a href="#" onclick="showTab('visualizacoes')" id="nav-visualizacoes">Visualizações Publicadas</a></li>
          <li><a href="#" onclick="showTab('explorar')" id="nav-explorar">Explorar Dados</a></li>
          <li><a href="#" onclick="showTab('pesquisa')" id="nav-pesquisa">Pesquisa & Instrumento</a></li>
          <li><a href="#" onclick="showTab('producoes')" id="nav-producoes">Produções</a></li>
          <li><a href="#" onclick="showTab('cadastro')" class="btn-cadastro" id="nav-cadastro">Cadastrar para Acesso</a></li>
          <li><a href="#" onclick="showTab('login')" class="btn-access" id="nav-login">Acessar</a></li>
        </ul>
      </nav>

      <div class="lang-selector">
        <div class="lang-btn active">PT</div>
        <div class="lang-btn">EN</div>
      </div>
    </div>
  </header>

  <!-- CONTEÚDO PRINCIPAL -->
  <main>

    <!-- TELA 1: HOME PÚBLICA (SEÇÃO 8 DA ESPECIFICAÇÃO v0.2) -->
    <section id="tab-home" class="tab-content active">
      <div class="hero-banner">
        <div class="hero-text">
          <span class="badge badge-demo">Publicação Científica Interativa v0.2</span>
          <h1>Plataforma de Inteligência de Dados, Saúde e Segurança na Pesca Artesanal</h1>
          <p>
            Plataforma do <strong>Projeto Banco de Dados Fundacentro e Produções</strong>. Publicação científica interativa para consulta, visualização, proveniência e extração de microdados do <em>Trabalho Saudável e Seguro na Pesca Artesanal</em>[cite: 14].
          </p>
          <div class="btn-group">
            <button class="btn btn-primary" onclick="showTab('visualizacoes')">Explorar Visualizações Publicadas</button>
            <button class="btn btn-secondary" onclick="showTab('explorar')">Acessar Ferramentas Analíticas</button>
          </div>
        </div>
      </div>

      <!-- Pesquisa em Números (Validados no Pacote) -->
      <div class="panel-header">Pesquisa em Números (Amostra Nacional Validada)</div>

      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="accent-line" style="background-color: var(--color-yellow);"></div>
          <span class="kpi-label">Amostra Processada (N)</span>
          <div class="kpi-value">16.623</div>
          <div class="kpi-sub">Entrevistas e formulários validados na base</div>
        </div>
        <div class="kpi-card">
          <div class="accent-line" style="background-color: var(--color-green);"></div>
          <span class="kpi-label">Atributos Mapeados</span>
          <div class="kpi-value">277</div>
          <div class="kpi-sub">26 cadastrais + 251 do instrumento wide</div>
        </div>
        <div class="kpi-card">
          <div class="accent-line" style="background-color: var(--color-blue);"></div>
          <span class="kpi-label">Questões Reconstruídas</span>
          <div class="kpi-value">36</div>
          <div class="kpi-sub">Entidades semânticas normalizadas (Q01 a Q36)</div>
        </div>
        <div class="kpi-card">
          <div class="accent-line" style="background-color: var(--color-red);"></div>
          <span class="kpi-label">Vetores de Alternativa</span>
          <div class="kpi-value">251</div>
          <div class="kpi-sub">Vetores indicadores binários (0/1) de resposta</div>
        </div>
      </div>

      <!-- Jornada Empírica Q01 a Q36 -->
      <div class="card" style="margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; flex-wrap: wrap; gap: 0.5rem;">
          <div>
            <h3 style="font-size: 1rem; font-weight: 800; color: var(--text-main);">Jornada do Instrumento (Sequência Empírica Q01 a Q36)</h3>
            <p style="font-size: 0.8rem; color: var(--text-muted);">A ordem empírica original do questionário é preservada integralmente[cite: 14]. Clique para abrir a questão.</p>
          </div>
          <span class="badge badge-validated">Modelo Lógico v0.1</span>
        </div>

        <div class="empiric-grid">
          <div class="q-item" onclick="openQuestion('Q01')"><span>Q01 Escolaridade</span><span class="q-sub">7 alternativas</span></div>
          <div class="q-item" onclick="openQuestion('Q02')"><span>Q02 Grupo Étnico</span><span class="q-sub">6 alternativas</span></div>
          <div class="q-item" onclick="openQuestion('Q06')"><span>Q06 Embarcação</span><span class="q-sub">5 alternativas</span></div>
          <div class="q-item" onclick="openQuestion('Q08')"><span>Q08 Apetrechos</span><span class="q-sub">12 alternativas</span></div>
          <div class="q-item" onclick="openQuestion('Q09')"><span>Q09 Exposição Solar</span><span class="q-sub">4 alternativas</span></div>
          <div class="q-item" onclick="openQuestion('Q15')"><span>Q15 Ruído Ocupacional</span><span class="q-sub">5 alternativas</span></div>
          <div class="q-item" onclick="openQuestion('Q17')"><span>Q17 Carga e Peso</span><span class="q-sub">6 alternativas</span></div>
          <div class="q-item" onclick="openQuestion('Q23')"><span>Q23 Acidentes</span><span class="q-sub">14 alternativas</span></div>
          <div class="q-item" onclick="openQuestion('Q27')"><span>Q27 Notificação CAT</span><span class="q-sub">4 alternativas</span></div>
