  <!-- CONTROLADOR JAVASCRIPT GLOBAL -->
  <script>
    function showTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
      document.querySelectorAll('nav a').forEach(link => link.classList.remove('active'));

      const targetTab = document.getElementById('tab-' + tabId);
      if (targetTab) targetTab.classList.add('active');

      const targetNav = document.getElementById('nav-' + tabId);
      if (targetNav) targetNav.classList.add('active');

      window.scrollTo({ top: 0, behavior: 'smooth' });

      if (tabId === 'visualizacoes' || tabId === 'home') {
        renderCharts();
      }
    }

    function openQuestion(qCode) {
      showTab('explorar');
      document.getElementById('filter-q').value = qCode;
      runQuery();
    }

    function setPivot(pivotType) {
      document.querySelectorAll('.chip-btn').forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');
    }

    function runQuery() {
      const qSelected = document.getElementById('filter-q').value;
      alert('Executando consulta analítica para a questão ' + qSelected + ' respeitando o Modelo Lógico v0.1.');
    }

    /* VISUALIZAÇÕES DE RENDERIZAÇÃO GRÁFICA (Chart.js) */
    let chartInstance1 = null;
    let chartInstance2 = null;

    function renderCharts() {
      if (chartInstance1) chartInstance1.destroy();
      if (chartInstance2) chartInstance2.destroy();

      Chart.defaults.font.family = "'Inter', sans-serif";
      Chart.defaults.color = '#475569';

      // 1. Radar Ocupacional
      const ctx1 = document.getElementById('chartRadarRiscos');
      if (ctx1) {
        chartInstance1 = new Chart(ctx1.getContext('2d'), {
          type: 'radar',
          data: {
            labels: [
              'Exposição Solar (Q09)',
              'Esforço / Peso (Q17)',
              'Movimento Repetitivo (Q21)',
              'Risco de Queda (Q22)',
              'Ruído / Barulho (Q15)',
              'Produtos Químicos (Q16)'
            ],
            datasets: [{
              label: 'Prevalência Amostral (%)',
              data: [74.2, 91.3, 82.5, 68.4, 42.1, 35.8],
              backgroundColor: 'rgba(29, 79, 177, 0.18)',
              borderColor: '#1D4FB1',
              borderWidth: 2.5,
              pointBackgroundColor: '#C27329',
              pointBorderColor: '#FFFFFF',
              pointRadius: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              r: {
                angleLines: { color: '#E2E0D2' },
                grid: { color: '#E2E0D2' },
                pointLabels: { font: { size: 10, weight: '600' }, color: '#0F172A' },
                ticks: { display: false, stepSize: 20 }
              }
            }
          }
        });
      }

      // 2. Donut Minimalista
      const ctx2 = document.getElementById('chartAcidentesDonut');
      if (ctx2) {
        chartInstance2 = new Chart(ctx2.getContext('2d'), {
          type: 'doughnut',
          data: {
            labels: [
              'Corte / Perfuração',
              'Queda na Embarcação / Lama',
              'Ferida por Animal Marinho',
              'Queimadura Solar Severa',
              'Não Sofreu Acidentes'
            ],
            datasets: [{
              data: [45.4, 29.6, 24.6, 14.6, 33.3],
              backgroundColor: ['#1D4FB1', '#C27329', '#E4C027', '#E22927', '#22C55E'],
              borderWidth: 3,
              borderColor: '#FFFFFF',
              hoverOffset: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '68%',
            plugins: {
              legend: {
                position: 'bottom',
                labels: { boxWidth: 12, padding: 15, font: { size: 11, weight: '500' } }
              }
            }
          }
        });
      }
    }

    // Inicializa gráficos após o carregamento da página
    window.addEventListener('DOMContentLoaded', () => {
      renderCharts();
    });
  </script>
